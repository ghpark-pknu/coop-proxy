{
    // Ctrl+Shift+B → 기본 빌드 작업(build: debug) 실행
    // 다른 작업은 F1 → "Tasks: Run Task" 에서 고른다
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: debug",
            "type": "shell",
            "command": "make -j$(nproc) MODE=debug",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build: asan",
            "type": "shell",
            "command": "make -j$(nproc) MODE=asan",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build: tsan",
            "type": "shell",
            "command": "make -j$(nproc) MODE=tsan",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build: release",
            "type": "shell",
            "command": "make -j$(nproc) MODE=release",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build: hello",
            "type": "shell",
            "command": "make hello MODE=debug",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
