{
    // Makefile의 명령 줄은 탭 문자여야 하므로 공백으로 바꾸지 않음
    "[makefile]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
    },
    // C 코드는 공백 4칸 들여쓰기
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // .h를 C 헤더로 지정
    "files.associations": {
        "*.h": "c"
    },
    // 리눅스 줄바꿈(LF)으로 저장. CRLF가 섞이면 셸 스크립트가 실행 X
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
}
