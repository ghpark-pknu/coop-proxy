{
    // F5 → 선택한 구성으로 빌드 후 gdb 디버깅 시작
    "version": "0.2.0",
    "configurations": [
        {
            "name": "hello_server 디버그 (환경 검증용)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/hello_server",
            "args": ["8080"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build: hello",
            "setupCommands": [
                { "description": "변수를 보기 좋게 출력", "text": "-enable-pretty-printing", "ignoreFailures": true },
                // 프로그램이 SIGPIPE를 무시하도록 해 두어도 gdb는 기본적으로 멈춘다.
                // 클라이언트가 연결을 끊을 때마다 멈추지 않게 그냥 넘기도록 설정한다.
                { "description": "SIGPIPE에서 멈추지 않기", "text": "handle SIGPIPE nostop noprint pass", "ignoreFailures": true }
            ]
        },
        {
            "name": "proxy 디버그 (클러스터 node1)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/proxy",
            // node2·node3과 원서버는 터미널에서 띄운다:
            //   ./scripts/cluster.sh start origin node2 node3
            "args": ["-n", "node1", "-C", "conf/cluster.conf"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build: debug",
            "setupCommands": [
                { "description": "변수를 보기 좋게 출력", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "SIGPIPE에서 멈추지 않기", "text": "handle SIGPIPE nostop noprint pass", "ignoreFailures": true }
            ]
        },
        {
            "name": "proxy 디버그",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/proxy",
            // 포트 8080, 노드 이름 node1 (3단계부터 노드 목록·설정 파일 인자가 추가됨)
            "args": ["-p", "8080", "-n", "node1"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build: debug",
            "setupCommands": [
                { "description": "변수를 보기 좋게 출력", "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "description": "SIGPIPE에서 멈추지 않기", "text": "handle SIGPIPE nostop noprint pass", "ignoreFailures": true }
            ]
        }
    ]
}
